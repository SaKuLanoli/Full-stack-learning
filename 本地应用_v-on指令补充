    <title>v-on指令补充</title>
</head>
<body>
    <div id="app">
        <input type="button" value="点击" @click="doIt(666,'老铁')">
        <input type="text" @keyup.enter="sayHi">
    </div>
    <script src="https://cdn.jsdelivr.net/npm/vue/dist/vue.js"></script>
    <script>
        var app = new Vue({
            el:"#app",
            data:{

            },
            methods:{
                doIt:function (p1,p2){
                    console.log("做IT");
                    console.log(p1);
                    console.log(p2);
                },
                sayHi:function (){
                    alert("吃了没？");
                }
            }
        })
    </script>
</body>
</html>
